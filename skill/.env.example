# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 获取 Key: https://bailian.console.aliyun.com/

DASHSCOPE_API_KEY=sk-xxx

# 可选：模型名（默认 qwen3-vl-flash；可换 qwen3-vl-plus / qwen3.7-plus / qwen3.8-max）
# VISION_MODEL=qwen3-vl-flash

# 可选：服务地址（非百炼平台时改为你的 OpenAI 兼容地址；带 /chat/completions 后缀会自动去掉）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：单图最长边上限 px（默认 7680，服务端建议 8K 以内；4K 以上仅支持 jpg/png）
# VISION_MAX_IMAGE_PX=7680

# 可选：失败自动重试次数（默认 2；429/5xx/超时会自动重试）
# VISION_MAX_RETRIES=2

# 可选：单次最多图片数（默认 20）
# VISION_MAX_IMAGES=20
