# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 获取 Key: https://bailian.console.aliyun.com/

DASHSCOPE_API_KEY=sk-xxx

# 可选：模型名（默认 qwen3-vl-flash；可换 qwen3-vl-plus / qwen3.7-plus / qwen3.8-max）
# VISION_MODEL=qwen3-vl-flash

# 可选：服务地址（非百炼平台时改为你的 OpenAI 兼容地址；带 /chat/completions 后缀会自动去掉）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：单图最长边上限 px（默认 7680，服务端建议 8K 以内；4K 以上仅支持 jpg/png）
# VISION_MAX_IMAGE_PX=7680

# 可选：最大输出 token（默认 1024）
# VISION_MAX_TOKENS=1024

# 可选：多图并发数（默认 3）
# VISION_CONCURRENCY=3

# 可选：失败自动重试次数（默认 2；429/5xx/超时会自动重试）
# VISION_MAX_RETRIES=2

# 可选：单次最多图片数（默认 20）
# VISION_MAX_IMAGES=20

# 可选：单图大小上限 MB（默认 7）
# VISION_MAX_IMAGE_MB=7

# 可选：多图合批（默认开 1/true；设 0 或 false 回退逐张并发）
# VISION_BATCH=1

# 可选：SSE 流式输出逐字显示（默认开 1/true；设 0 或 false 关闭）
# VISION_STREAM=1

# 可选：自动缩放最长边到指定像素（默认 0 不缩放；如 1500，macOS sips 下生效）
# VISION_AUTO_RESIZE_PX=0

# 可选：PNG 自动转 JPEG 省 token（默认 0；设 1 或 true 启用，macOS sips 下生效）
# VISION_CONVERT_PNG=0

# 可选：--locate 时限定 opencode 会话 ID（默认取最新附件；并发多会话时用）
# VISION_OPENCODE_SESSION=
